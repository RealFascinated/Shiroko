{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "arona",
      "folder": "Arona",
      "interval": "1m",
      "rules": [
        {
          "uid": "arona-down",
          "title": "Bot down",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "ffbmdvoh37lkwe",
              "model": {
                "expr": "absent_over_time(uptime_seconds{job=\"arona\"}[5m])",
                "instant": true,
                "range": false,
                "queryType": "MetricsQL",
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "2m",
          "annotations": {
            "summary": "Arona has not pushed metrics for 5 minutes."
          },
          "labels": {
            "severity": "critical"
          },
          "isPaused": false
        },
        {
          "uid": "arona-job-stale",
          "title": "Job stale",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "ffbmdvoh37lkwe",
              "model": {
                "expr": "(time() - max by (name) (job_last_success_timestamp_seconds{job=\"arona\"})) - max by (name) (2 * job_interval_seconds{job=\"arona\"} + 300)",
                "instant": true,
                "range": false,
                "queryType": "MetricsQL",
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "Job {{ $labels.name }} has not succeeded for over two of its periods."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        },
        {
          "uid": "arona-job-failures",
          "title": "Job failing",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "ffbmdvoh37lkwe",
              "model": {
                "expr": "sum by (name) (increase(job_failures_total{job=\"arona\"}[1h]))",
                "instant": true,
                "range": false,
                "queryType": "MetricsQL",
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "Job {{ $labels.name }} threw in the last hour."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        },
        {
          "uid": "arona-invalid-requests",
          "title": "Invalid request ban risk",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "ffbmdvoh37lkwe",
              "model": {
                "expr": "max(discord_rest_invalid_requests{job=\"arona\"})",
                "instant": true,
                "range": false,
                "queryType": "MetricsQL",
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        5000
                      ]
                    }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "Over half of Discord's 10,000 invalid requests per 10 minutes used; the IP ban is near."
          },
          "labels": {
            "severity": "critical"
          },
          "isPaused": false
        },
        {
          "uid": "arona-rate-limits",
          "title": "Sustained rate limiting",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "ffbmdvoh37lkwe",
              "model": {
                "expr": "sum(increase(discord_rest_rate_limits_total{job=\"arona\"}[10m]))",
                "instant": true,
                "range": false,
                "queryType": "MetricsQL",
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        50
                      ]
                    }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "annotations": {
            "summary": "More than 50 requests per 10 minutes are queueing behind rate limits."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        },
        {
          "uid": "arona-expired-interactions",
          "title": "Interactions expiring",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "ffbmdvoh37lkwe",
              "model": {
                "expr": "sum(increase(discord_interactions_expired_total{job=\"arona\"}[15m]))",
                "instant": true,
                "range": false,
                "queryType": "MetricsQL",
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        3
                      ]
                    }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "Several interactions in 15 minutes were answered after Discord's 3s window."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        },
        {
          "uid": "arona-event-loop",
          "title": "Event loop blocked",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "ffbmdvoh37lkwe",
              "model": {
                "expr": "histogram_quantile(0.95, sum by (le) (rate(event_loop_ms_bucket{job=\"arona\"}[5m])))",
                "instant": true,
                "range": false,
                "queryType": "MetricsQL",
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        200
                      ]
                    }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "annotations": {
            "summary": "Event loop p95 delay has been above 200ms for 10 minutes."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        },
        {
          "uid": "arona-db-pool",
          "title": "Database pool exhausted",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "ffbmdvoh37lkwe",
              "model": {
                "expr": "max(db_pool_connections{job=\"arona\",state=\"waiting\"})",
                "instant": true,
                "range": false,
                "queryType": "MetricsQL",
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "Queries have been waiting on a Postgres connection for 5 minutes."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        },
        {
          "uid": "arona-heap",
          "title": "Heap near limit",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "ffbmdvoh37lkwe",
              "model": {
                "expr": "max(process_ram_used{job=\"arona\"}) / max(process_ram_total{job=\"arona\"})",
                "instant": true,
                "range": false,
                "queryType": "MetricsQL",
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                },
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.9
                      ]
                    }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "annotations": {
            "summary": "Heap use has been above 90% of the limit for 10 minutes."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        }
      ]
    }
  ]
}
